//@version=6\nindicator(\"Circuit Breaker + TT\", overlay=true, max_lines_count=500)\n\n// TwinTower Fills are now handled within the settlement-aware drawing system\n// No global plot anchors needed - fills are drawn per settlement period\n\n// =============================================================================\n// --- Type Definitions ---\n// =============================================================================\n\ntype MarketConfig\n    string name\n    string settlementTimezone\n    int settlementHour\n    int settlementMinute\n    int settlementSecond\n\n// =============================================================================\n// --- User Inputs ---\n// =============================================================================\n\n// 1. General Settings (Top Priority)\nvar g_general = \"General Settings\"\ni_market = input.string(\"CRYPTO\", \"Market\", options=[\"CRYPTO\", \"INDICES\", \"FOREX\"], group = g_general)\ni_fixPriceManual = input.float(0.0, \"Manual Fix Price (0 = Auto)\", group = g_general, minval=0.0, step=0.01)\ni_historicalPeriods = input.int(10, \"Historical Periods to Show\", group = g_general, minval=1, maxval=50)\n\n// 2. Main CB Levels\nvar g_main_cb = \"Main CB Levels\"\ni_showCB7 = input.bool(true, \"7% CB\", group = g_main_cb)\ni_showCB7_Mid = input.bool(false, \"7% CB-mid\", group = g_main_cb)\ni_showCB35 = input.bool(false, \"3.5% CB\", group = g_main_cb)\ni_showCB35_Mid = input.bool(false, \"3.5% CB-mid\", group = g_main_cb)\n\n// 2b. Crypto CB Levels\nvar g_crypto_cb = \"Crypto CB Levels\"\ni_cryptoLevels10 = input.int(3, \"Number of 10% CB Lines\", group = g_crypto_cb, minval=0, maxval=10, tooltip=\"How many 10% CB levels to show (10%, 20%, 30%, etc.)\")\ni_showCrypto10_Mid = input.bool(false, \"10% CB-mid\", group = g_crypto_cb)\ni_cryptoLevels1 = input.int(3, \"Number of 1% CB Lines\", group = g_crypto_cb, minval=0, maxval=10, tooltip=\"How many 1% CB levels to show (1%, 2%, 3%, etc.)\")\ni_showCrypto1_Mid = input.bool(false, \"1% CB-mid\", group = g_crypto_cb)\n\n// 3. Decimated CB Levels\nvar g_decimated_cb = \"Decimated CB Levels\"\ni_showCB07 = input.bool(false, \"0.7% CB (/10)\", group = g_decimated_cb)\ni_showCB07_Mid = input.bool(false, \"0.7% CB (/10)-mid\", group = g_decimated_cb)\ni_showCB35_07 = input.bool(false, \"0.35% CB (/10)\", group = g_decimated_cb)\ni_showCB35_07_Mid = input.bool(false, \"0.35% CB (/10)-mid\", group = g_decimated_cb)\n\n// 4. Twin Tower Levels (After Decimated CB)\nvar g_twin_tower = \"Twin Tower Levels\"\ni_showTwinTower = input.bool(false, \"Twin Tower\", group = g_twin_tower)\ni_showTwinTowerMini = input.bool(false, \"Twin Tower Mini\", group = g_twin_tower)\ni_ttFillOn = input.bool(false, \"TwinTower Fill\", group = g_twin_tower)\ni_ttFillMode = input.string(\"Current Period Only\", \"Fill Mode\", options=[\"Current Period Only\", \"All Periods\"], group = g_twin_tower, tooltip=\"Current Period Only: Consistent color strength. All Periods: May appear lighter with multiple overlapping periods.\")\ni_ttFillColor = input.color(color.new(color.blue, 85), \"Fill Color\", group = g_twin_tower)\n\n// Declare fixPrice early (calculated later in main logic)\nvar float fixPrice = na\n\n\n// TwinTower Fill Logic will be handled within settlement-aware drawing system\n\n// 5. Style Settings\nvar g_style = \"Style\"\ni_fixPriceColor = input.color(color.red, \"Fix Price\", group = g_style)\ni_mainCBColor = input.color(color.black, \"7% CB Levels\", group = g_style)\ni_mainCBMidColor = input.color(color.gray, \"7% CB Mid-levels\", group = g_style)\ni_cb35Color = input.color(color.purple, \"3.5% CB Levels\", group = g_style)\ni_cb35MidColor = input.color(color.fuchsia, \"3.5% CB Mid-levels\", group = g_style)\ni_decimatedCBColor = input.color(color.green, \"DEC CB Levels\", group = g_style)\ni_decimatedCBMidColor = input.color(color.silver, \"DEC CB Mid-levels\", group = g_style)\ni_twinTowerColor = input.color(color.blue, \"Twin Tower Levels\", group = g_style)\ni_twinTowerMiniColor = input.color(color.orange, \"Twin Tower Mini Levels\", group = g_style)\n\n// 5b. Crypto Colors\nvar g_crypto_colors = \"Crypto Colors\"\ni_crypto10Color = input.color(color.red, \"10% CB Levels\", group = g_crypto_colors)\ni_crypto10MidColor = input.color(color.maroon, \"10% CB Mid-levels\", group = g_crypto_colors)\ni_crypto1Color = input.color(color.blue, \"1% CB Levels\", group = g_crypto_colors)\ni_crypto1MidColor = input.color(color.aqua, \"1% CB Mid-levels\", group = g_crypto_colors)\n\n// =============================================================================\n// --- Configuration & Calculation Modules ---\n// =============================================================================\n\n// Reusable function to calculate CB levels and mid-levels\nf_calculateCBLevels(basePrice, percentage) =>\n    upLevel = not na(basePrice) ? basePrice * (1 + percentage / 100) : na\n    dnLevel = not na(basePrice) ? basePrice * (1 - percentage / 100) : na\n    upMid = not na(basePrice) and not na(upLevel) ? (basePrice + upLevel) / 2 : na\n    dnMid = not na(basePrice) and not na(dnLevel) ? (basePrice + dnLevel) / 2 : na\n    [upLevel, dnLevel, upMid, dnMid]\n\nf_calculateTwinTowerLevels(basePrice, percentage) =>\n    rangeSize = basePrice * (percentage / 100)  // 7% of fixPrice for indices\n    \n    // Only calculate inner levels (excluding 0, 0.5, and 1.0)\n    // Levels above fixPrice\n    level_86_up = basePrice + (0.86 * rangeSize)\n    level_74_up = basePrice + (0.74 * rangeSize)  \n    level_60_up = basePrice + (0.6 * rangeSize)\n    level_40_up = basePrice + (0.4 * rangeSize)\n    level_26_up = basePrice + (0.26 * rangeSize)\n    level_14_up = basePrice + (0.14 * rangeSize)\n    \n    // Levels below fixPrice\n    level_86_dn = basePrice - (0.86 * rangeSize)\n    level_74_dn = basePrice - (0.74 * rangeSize)  \n    level_60_dn = basePrice - (0.6 * rangeSize)\n    level_40_dn = basePrice - (0.4 * rangeSize)\n    level_26_dn = basePrice - (0.26 * rangeSize)\n    level_14_dn = basePrice - (0.14 * rangeSize)\n    \n    [level_86_up, level_74_up, level_60_up, level_40_up, level_26_up, level_14_up,\n     level_86_dn, level_74_dn, level_60_dn, level_40_dn, level_26_dn, level_14_dn]\n\n// Function to get market-specific circuit breaker percentages\n// Returns tuple: [main1, main2, main3, dec1, dec2, dec3]\nf_getMarketCBPercentages() =>\n    main1 = i_market == \"CRYPTO\" ? 10.0 : i_market == \"INDICES\" ? 6.93 : 4.0\n    main2 = i_market == \"CRYPTO\" ? 20.0 : i_market == \"INDICES\" ? 12.6 : 8.0\n    main3 = i_market == \"CRYPTO\" ? 30.0 : i_market == \"INDICES\" ? 19.8 : 12.0\n    dec1 = i_market == \"CRYPTO\" ? 1.0 : i_market == \"INDICES\" ? 0.693 : 0.4\n    dec2 = i_market == \"CRYPTO\" ? 2.0 : i_market == \"INDICES\" ? 1.26 : 0.8\n    dec3 = i_market == \"CRYPTO\" ? 3.0 : i_market == \"INDICES\" ? 1.98 : 1.2\n    [main1, main2, main3, dec1, dec2, dec3]\n\nf_getMarketConfig() =>\n    switch i_market\n        \"CRYPTO\" =>\n            MarketConfig.new(\"CRYPTO\", \"America/Chicago\", 14, 59, 30)\n        \"INDICES\" =>\n            MarketConfig.new(\"INDICES\", \"America/New_York\", 15, 49, 30)\n        \"FOREX\" =>\n            MarketConfig.new(\"FOREX\", \"America/New_York\", 16, 59, 30)\n\n\nf_getFixPrice(config) =>\n    isSettlementTime = hour(time, config.settlementTimezone) == config.settlementHour and minute(time, config.settlementTimezone) == config.settlementMinute and second(time, config.settlementTimezone) == config.settlementSecond\n    newSettlement = (isSettlementTime and not isSettlementTime[1]) or timeframe.change(\"1D\")\n    var float tempFixPrice = na\n    if i_fixPriceManual > 0.0\n        tempFixPrice := i_fixPriceManual\n    else if newSettlement or na(fixPrice)\n        tempFixPrice := request.security(syminfo.tickerid, \"1D\", close[1], lookahead=barmerge.lookahead_on)\n    else\n        tempFixPrice := fixPrice\n    tempFixPrice\n\n\n// =============================================================================\n// --- Main Logic ---\n// =============================================================================\n\nmarketConfig = f_getMarketConfig()\nfixPrice := f_getFixPrice(marketConfig)\n\n// Settlement detection\nisSettlementTime = hour(time, marketConfig.settlementTimezone) == marketConfig.settlementHour and minute(time, marketConfig.settlementTimezone) == marketConfig.settlementMinute and second(time, marketConfig.settlementTimezone) == marketConfig.settlementSecond\nnewSettlement = (isSettlementTime and not isSettlementTime[1]) or timeframe.change(\"1D\")\n\n// TwinTower fills are now handled within settlement-aware drawing system\n\n// Calculate market-specific CB levels using tuple destructuring\n// All markets now return [main1, main2, main3, dec1, dec2, dec3]\n[main1_pct, main2_pct, main3_pct, dec1_pct, dec2_pct, dec3_pct] = f_getMarketCBPercentages()\ntwinTowerBase = main1_pct  // Use first level for Twin Tower base\n\n// Calculate 3.5% CB levels (only for INDICES market)\ncb35_pct_1 = i_market == \"INDICES\" ? 3.465 : na\ncb35_pct_2 = i_market == \"INDICES\" ? 6.93 : na  // 2 * 3.465\ncb35_pct_3 = i_market == \"INDICES\" ? 10.395 : na  // 3 * 3.465\n\n// Calculate decimated 3.5% CB levels (only for INDICES market)\ncb35_dec1 = i_market == \"INDICES\" ? 0.3465 : na  // 3.465 / 10\ncb35_dec2 = i_market == \"INDICES\" ? 0.693 : na   // 6.93 / 10\ncb35_dec3 = i_market == \"INDICES\" ? 1.0395 : na  // 10.395 / 10\n\n[upPrice_1, dnPrice_1, upMid_1, dnMid_1] = f_calculateCBLevels(fixPrice, main1_pct)\n[upPrice_2, dnPrice_2, upMid_2, dnMid_2] = f_calculateCBLevels(fixPrice, main2_pct)\n[upPrice_3, dnPrice_3, upMid_3, dnMid_3] = f_calculateCBLevels(fixPrice, main3_pct)\n[upPrice_dec1, dnPrice_dec1, upMid_dec1, dnMid_dec1] = f_calculateCBLevels(fixPrice, dec1_pct)\n[upPrice_dec2, dnPrice_dec2, upMid_dec2, dnMid_dec2] = f_calculateCBLevels(fixPrice, dec2_pct)\n[upPrice_dec3, dnPrice_dec3, upMid_dec3, dnMid_dec3] = f_calculateCBLevels(fixPrice, dec3_pct)\n\n// Calculate 3.5% CB levels\n[upPrice_cb35_1, dnPrice_cb35_1, upMid_cb35_1, dnMid_cb35_1] = f_calculateCBLevels(fixPrice, cb35_pct_1)\n[upPrice_cb35_2, dnPrice_cb35_2, upMid_cb35_2, dnMid_cb35_2] = f_calculateCBLevels(fixPrice, cb35_pct_2)\n[upPrice_cb35_3, dnPrice_cb35_3, upMid_cb35_3, dnMid_cb35_3] = f_calculateCBLevels(fixPrice, cb35_pct_3)\n\n// Calculate decimated 3.5% CB levels\n[upPrice_cb35_dec1, dnPrice_cb35_dec1, upMid_cb35_dec1, dnMid_cb35_dec1] = f_calculateCBLevels(fixPrice, cb35_dec1)\n[upPrice_cb35_dec2, dnPrice_cb35_dec2, upMid_cb35_dec2, dnMid_cb35_dec2] = f_calculateCBLevels(fixPrice, cb35_dec2)\n[upPrice_cb35_dec3, dnPrice_cb35_dec3, upMid_cb35_dec3, dnMid_cb35_dec3] = f_calculateCBLevels(fixPrice, cb35_dec3)\n\n// Calculate Twin Tower levels\n[tt_86_up, tt_74_up, tt_60_up, tt_40_up, tt_26_up, tt_14_up, tt_86_dn, tt_74_dn, tt_60_dn, tt_40_dn, tt_26_dn, tt_14_dn] = f_calculateTwinTowerLevels(fixPrice, twinTowerBase)\n\n// Calculate Twin Tower Mini levels\n[ttm_86_up, ttm_74_up, ttm_60_up, ttm_40_up, ttm_26_up, ttm_14_up, ttm_86_dn, ttm_74_dn, ttm_60_dn, ttm_40_dn, ttm_26_dn, ttm_14_dn] = f_calculateTwinTowerLevels(fixPrice, dec1_pct)\n\n// TwinTower fills are now integrated within the historical drawing loop\n\n// =============================================================================\n// --- Line-Based Drawing System ---\n// =============================================================================\n\n// Function to draw CB levels using lines from settlement to settlement\nf_drawCBLevels(showLevel, showMid, upPrice1, dnPrice1, upPrice2, dnPrice2, upPrice3, dnPrice3, upMid1, dnMid1, levelColor, midColor, startIdx, endIdx) =>\n    if showLevel and not na(startIdx) and not na(endIdx)\n        // Main CB levels\n        if not na(upPrice1)\n            line.new(startIdx, upPrice1, endIdx, upPrice1, color=levelColor, width=1, xloc=xloc.bar_index)\n        if not na(dnPrice1)\n            line.new(startIdx, dnPrice1, endIdx, dnPrice1, color=levelColor, width=1, xloc=xloc.bar_index)\n        if not na(upPrice2)\n            line.new(startIdx, upPrice2, endIdx, upPrice2, color=levelColor, width=1, xloc=xloc.bar_index)\n        if not na(dnPrice2)\n            line.new(startIdx, dnPrice2, endIdx, dnPrice2, color=levelColor, width=1, xloc=xloc.bar_index)\n        if not na(upPrice3)\n            line.new(startIdx, upPrice3, endIdx, upPrice3, color=levelColor, width=1, xloc=xloc.bar_index)\n        if not na(dnPrice3)\n            line.new(startIdx, dnPrice3, endIdx, dnPrice3, color=levelColor, width=1, xloc=xloc.bar_index)\n    \n    if showMid and not na(startIdx) and not na(endIdx)\n        // Mid-levels between fix and first level\n        if not na(upMid1)\n            line.new(startIdx, upMid1, endIdx, upMid1, color=midColor, width=1, xloc=xloc.bar_index)\n        if not na(dnMid1)\n            line.new(startIdx, dnMid1, endIdx, dnMid1, color=midColor, width=1, xloc=xloc.bar_index)\n        \n        // Mid-levels between levels\n        mid_1_2_up = not na(upPrice1) and not na(upPrice2) ? (upPrice1 + upPrice2) / 2 : na\n        mid_1_2_dn = not na(dnPrice1) and not na(dnPrice2) ? (dnPrice1 + dnPrice2) / 2 : na\n        mid_2_3_up = not na(upPrice2) and not na(upPrice3) ? (upPrice2 + upPrice3) / 2 : na\n        mid_2_3_dn = not na(dnPrice2) and not na(dnPrice3) ? (dnPrice2 + dnPrice3) / 2 : na\n        \n        if not na(mid_1_2_up)\n            line.new(startIdx, mid_1_2_up, endIdx, mid_1_2_up, color=midColor, width=1, xloc=xloc.bar_index)\n        if not na(mid_1_2_dn)\n            line.new(startIdx, mid_1_2_dn, endIdx, mid_1_2_dn, color=midColor, width=1, xloc=xloc.bar_index)\n        if not na(mid_2_3_up)\n            line.new(startIdx, mid_2_3_up, endIdx, mid_2_3_up, color=midColor, width=1, xloc=xloc.bar_index)\n        if not na(mid_2_3_dn)\n            line.new(startIdx, mid_2_3_dn, endIdx, mid_2_3_dn, color=midColor, width=1, xloc=xloc.bar_index)\n\n// Function to draw Twin Tower levels from settlement to settlement\nf_drawTwinTowerLines(startIndex, endIndex, l86_up, l74_up, l60_up, l40_up, l26_up, l14_up, l86_dn, l74_dn, l60_dn, l40_dn, l26_dn, l14_dn, towerColor) =>\n    if not na(startIndex) and not na(endIndex)\n        // Up levels\n        line.new(startIndex, l86_up, endIndex, l86_up, color=towerColor, width=1, xloc=xloc.bar_index)\n        line.new(startIndex, l74_up, endIndex, l74_up, color=towerColor, width=1, xloc=xloc.bar_index)\n        line.new(startIndex, l60_up, endIndex, l60_up, color=towerColor, width=1, xloc=xloc.bar_index)\n        line.new(startIndex, l40_up, endIndex, l40_up, color=towerColor, width=1, xloc=xloc.bar_index)\n        line.new(startIndex, l26_up, endIndex, l26_up, color=towerColor, width=1, xloc=xloc.bar_index)\n        line.new(startIndex, l14_up, endIndex, l14_up, color=towerColor, width=1, xloc=xloc.bar_index)\n        \n        // Down levels\n        line.new(startIndex, l86_dn, endIndex, l86_dn, color=towerColor, width=1, xloc=xloc.bar_index)\n        line.new(startIndex, l74_dn, endIndex, l74_dn, color=towerColor, width=1, xloc=xloc.bar_index)\n        line.new(startIndex, l60_dn, endIndex, l60_dn, color=towerColor, width=1, xloc=xloc.bar_index)\n        line.new(startIndex, l40_dn, endIndex, l40_dn, color=towerColor, width=1, xloc=xloc.bar_index)\n        line.new(startIndex, l26_dn, endIndex, l26_dn, color=towerColor, width=1, xloc=xloc.bar_index)\n        line.new(startIndex, l14_dn, endIndex, l14_dn, color=towerColor, width=1, xloc=xloc.bar_index)\n\n// Function to draw Crypto CB levels using lines from settlement to settlement\nf_drawCryptoCBLevels(startIdx, endIdx, fixPriceValue) =>\n    if i_market == \"CRYPTO\" and not na(startIdx) and not na(endIdx) and not na(fixPriceValue)\n\n        // Draw 10% CB levels (10%, 20%, 30%, etc.)\n        if i_cryptoLevels10 > 0\n            for i = 1 to i_cryptoLevels10\n                pct = 10.0 * i\n                [up, dn, upMid, dnMid] = f_calculateCBLevels(fixPriceValue, pct)\n\n                // Draw main levels\n                if not na(up)\n                    line.new(startIdx, up, endIdx, up, color=i_crypto10Color, width=1, xloc=xloc.bar_index)\n                if not na(dn)\n                    line.new(startIdx, dn, endIdx, dn, color=i_crypto10Color, width=1, xloc=xloc.bar_index)\n\n                // Draw mid-levels for first level only\n                if i_showCrypto10_Mid and i == 1\n                    if not na(upMid)\n                        line.new(startIdx, upMid, endIdx, upMid, color=i_crypto10MidColor, width=1, xloc=xloc.bar_index)\n                    if not na(dnMid)\n                        line.new(startIdx, dnMid, endIdx, dnMid, color=i_crypto10MidColor, width=1, xloc=xloc.bar_index)\n\n        // Draw 1% CB levels (1%, 2%, 3%, etc.)\n        if i_cryptoLevels1 > 0\n            for i = 1 to i_cryptoLevels1\n                pct = 1.0 * i\n                [up, dn, upMid, dnMid] = f_calculateCBLevels(fixPriceValue, pct)\n\n                // Draw main levels\n                if not na(up)\n                    line.new(startIdx, up, endIdx, up, color=i_crypto1Color, width=1, xloc=xloc.bar_index)\n                if not na(dn)\n                    line.new(startIdx, dn, endIdx, dn, color=i_crypto1Color, width=1, xloc=xloc.bar_index)\n\n                // Draw mid-levels for first level only\n                if i_showCrypto1_Mid and i == 1\n                    if not na(upMid)\n                        line.new(startIdx, upMid, endIdx, upMid, color=i_crypto1MidColor, width=1, xloc=xloc.bar_index)\n                    if not na(dnMid)\n                        line.new(startIdx, dnMid, endIdx, dnMid, color=i_crypto1MidColor, width=1, xloc=xloc.bar_index)\n\n\n// Store settlement start for current period\nvar int settlementStartIdx = na\n\n// Historical data storage arrays\nvar array<int> historicalSettlements = array.new<int>()\nvar array<float> historicalFixPrices = array.new<float>()\n\n\n// Detect new settlement and store the bar index\nif newSettlement\n    settlementStartIdx := bar_index\n\n    // Store historical settlement data\n    array.push(historicalSettlements, bar_index)\n    array.push(historicalFixPrices, fixPrice)\n\n    // Maintain only the specified number of historical periods\n    if array.size(historicalSettlements) > i_historicalPeriods\n        array.shift(historicalSettlements)\n        array.shift(historicalFixPrices)\n\n\n// Draw historical levels for the specified number of settlement periods\nif array.size(historicalSettlements) > 0\n    // Calculate how many periods to draw (from the most recent backwards)\n    startIndex = math.max(0, array.size(historicalSettlements) - i_historicalPeriods)\n    for i = startIndex to array.size(historicalSettlements) - 1\n        histSettlement = array.get(historicalSettlements, i)\n        histFixPrice = array.get(historicalFixPrices, i)\n        \n        // Calculate end point: next settlement or current bar if it's the latest period\n        histEndPoint = i < array.size(historicalSettlements) - 1 ? array.get(historicalSettlements, i + 1) : bar_index\n    \n        \n        // Calculate CB levels for this historical period\n        [hist_main1_pct, hist_main2_pct, hist_main3_pct, hist_dec1_pct, hist_dec2_pct, hist_dec3_pct] = f_getMarketCBPercentages()\n        hist_twinTowerBase = hist_main1_pct\n        \n        // Calculate 3.5% CB levels (only for INDICES market)\n        hist_cb35_pct_1 = i_market == \"INDICES\" ? 3.465 : na\n        hist_cb35_pct_2 = i_market == \"INDICES\" ? 6.93 : na\n        hist_cb35_pct_3 = i_market == \"INDICES\" ? 10.395 : na\n        \n        // Calculate decimated 3.5% CB levels (only for INDICES market)\n        hist_cb35_dec1 = i_market == \"INDICES\" ? 0.3465 : na\n        hist_cb35_dec2 = i_market == \"INDICES\" ? 0.693 : na\n        hist_cb35_dec3 = i_market == \"INDICES\" ? 1.0395 : na\n    \n        \n        [hist_upPrice_1, hist_dnPrice_1, hist_upMid_1, hist_dnMid_1] = f_calculateCBLevels(histFixPrice, hist_main1_pct)\n        [hist_upPrice_2, hist_dnPrice_2, hist_upMid_2, hist_dnMid_2] = f_calculateCBLevels(histFixPrice, hist_main2_pct)\n        [hist_upPrice_3, hist_dnPrice_3, hist_upMid_3, hist_dnMid_3] = f_calculateCBLevels(histFixPrice, hist_main3_pct)\n        [hist_upPrice_dec1, hist_dnPrice_dec1, hist_upMid_dec1, hist_dnMid_dec1] = f_calculateCBLevels(histFixPrice, hist_dec1_pct)\n        [hist_upPrice_dec2, hist_dnPrice_dec2, hist_upMid_dec2, hist_dnMid_dec2] = f_calculateCBLevels(histFixPrice, hist_dec2_pct)\n        [hist_upPrice_dec3, hist_dnPrice_dec3, hist_upMid_dec3, hist_dnMid_dec3] = f_calculateCBLevels(histFixPrice, hist_dec3_pct)\n    \n        \n        // Calculate 3.5% CB levels\n        [hist_upPrice_cb35_1, hist_dnPrice_cb35_1, hist_upMid_cb35_1, hist_dnMid_cb35_1] = f_calculateCBLevels(histFixPrice, hist_cb35_pct_1)\n        [hist_upPrice_cb35_2, hist_dnPrice_cb35_2, hist_upMid_cb35_2, hist_dnMid_cb35_2] = f_calculateCBLevels(histFixPrice, hist_cb35_pct_2)\n        [hist_upPrice_cb35_3, hist_dnPrice_cb35_3, hist_upMid_cb35_3, hist_dnMid_cb35_3] = f_calculateCBLevels(histFixPrice, hist_cb35_pct_3)\n        \n        // Calculate decimated 3.5% CB levels\n        [hist_upPrice_cb35_dec1, hist_dnPrice_cb35_dec1, hist_upMid_cb35_dec1, hist_dnMid_cb35_dec1] = f_calculateCBLevels(histFixPrice, hist_cb35_dec1)\n        [hist_upPrice_cb35_dec2, hist_dnPrice_cb35_dec2, hist_upMid_cb35_dec2, hist_dnMid_cb35_dec2] = f_calculateCBLevels(histFixPrice, hist_cb35_dec2)\n        [hist_upPrice_cb35_dec3, hist_dnPrice_cb35_dec3, hist_upMid_cb35_dec3, hist_dnMid_cb35_dec3] = f_calculateCBLevels(histFixPrice, hist_cb35_dec3)\n    \n        \n        // Calculate Twin Tower levels\n        [hist_tt_86_up, hist_tt_74_up, hist_tt_60_up, hist_tt_40_up, hist_tt_26_up, hist_tt_14_up, hist_tt_86_dn, hist_tt_74_dn, hist_tt_60_dn, hist_tt_40_dn, hist_tt_26_dn, hist_tt_14_dn] = f_calculateTwinTowerLevels(histFixPrice, hist_twinTowerBase)\n        \n        // Calculate Twin Tower Mini levels\n        [hist_ttm_86_up, hist_ttm_74_up, hist_ttm_60_up, hist_ttm_40_up, hist_ttm_26_up, hist_ttm_14_up, hist_ttm_86_dn, hist_ttm_74_dn, hist_ttm_60_dn, hist_ttm_40_dn, hist_ttm_26_dn, hist_ttm_14_dn] = f_calculateTwinTowerLevels(histFixPrice, hist_dec1_pct)\n    \n        \n        // Draw Fix Price line from settlement to settlement\n        if not na(histFixPrice)\n            line.new(histSettlement, histFixPrice, histEndPoint, histFixPrice, color=i_fixPriceColor, width=2, xloc=xloc.bar_index)\n    \n        \n        // Draw Main CB levels (only for INDICES and FOREX, not CRYPTO)\n        if i_market != \"CRYPTO\"\n            f_drawCBLevels(i_showCB7, i_showCB7_Mid, hist_upPrice_1, hist_dnPrice_1, hist_upPrice_2, hist_dnPrice_2, hist_upPrice_3, hist_dnPrice_3, hist_upMid_1, hist_dnMid_1, i_mainCBColor, i_mainCBMidColor, histSettlement, histEndPoint)\n\n            // Draw 3.5% CB levels\n            f_drawCBLevels(i_showCB35, i_showCB35_Mid, hist_upPrice_cb35_1, hist_dnPrice_cb35_1, hist_upPrice_cb35_2, hist_dnPrice_cb35_2, hist_upPrice_cb35_3, hist_dnPrice_cb35_3, hist_upMid_cb35_1, hist_dnMid_cb35_1, i_cb35Color, i_cb35MidColor, histSettlement, histEndPoint)\n\n            // Draw Decimated CB levels\n            f_drawCBLevels(i_showCB07, i_showCB07_Mid, hist_upPrice_dec1, hist_dnPrice_dec1, hist_upPrice_dec2, hist_dnPrice_dec2, hist_upPrice_dec3, hist_dnPrice_dec3, hist_upMid_dec1, hist_dnMid_dec1, i_decimatedCBColor, i_decimatedCBMidColor, histSettlement, histEndPoint)\n\n            // Draw Decimated 3.5% CB levels\n            f_drawCBLevels(i_showCB35_07, i_showCB35_07_Mid, hist_upPrice_cb35_dec1, hist_dnPrice_cb35_dec1, hist_upPrice_cb35_dec2, hist_dnPrice_cb35_dec2, hist_upPrice_cb35_dec3, hist_dnPrice_cb35_dec3, hist_upMid_cb35_dec1, hist_dnMid_cb35_dec1, i_decimatedCBColor, i_decimatedCBMidColor, histSettlement, histEndPoint)\n\n        // Draw Crypto CB levels\n        f_drawCryptoCBLevels(histSettlement, histEndPoint, histFixPrice)\n\n\n        // Draw Twin Tower levels\n        if i_showTwinTower\n            f_drawTwinTowerLines(histSettlement, histEndPoint, hist_tt_86_up, hist_tt_74_up, hist_tt_60_up, hist_tt_40_up, hist_tt_26_up, hist_tt_14_up, hist_tt_86_dn, hist_tt_74_dn, hist_tt_60_dn, hist_tt_40_dn, hist_tt_26_dn, hist_tt_14_dn, i_twinTowerColor)\n            \n            // Draw Twin Tower fills (60% and 40